# ---- 数据库：默认 SQLite，零依赖 ----
DB_MODE=sqlite
# SQLITE_PATH=./kg.db

# 可选 PostgreSQL（需先启动实例）
# DB_MODE=postgres
# DATABASE_URL=postgresql://kg_user:kg_pass@localhost:5432/knowledge_graph

# ---- 服务 ----
HOST=0.0.0.0
PORT=8080
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 管理员口令（务必修改）----
ADMIN_TOKEN=change-me-to-a-long-random-secret
REGISTRATION_OPEN=false

# ---- 语义向量（可选；缺依赖时自动降级为字面重合）----
VECTOR_BACKEND=auto
VECTOR_MODEL=paraphrase-multilingual-MiniLM-L12-v2
HF_ENDPOINT=https://hf-mirror.com

# ---- 上传与导出 ----
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports

# ---- 知识点判定：联网存在性确认 ----
# confirmed 时分数不低于 FLOOR（至少进待审）；MIN_DOMAINS 为多源门槛
VERDICT_USE_WEB=true
VERDICT_WEB_EXISTENCE_FLOOR=0.35
VERDICT_WEB_MIN_DOMAINS=2
VERDICT_WEB_DESC_CONSISTENCY=0.25
