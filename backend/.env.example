# Database
DATABASE_URL=postgresql://kg_user:kg_pass@localhost:5432/knowledge_graph

# For lightweight dev without PostgreSQL, use SQLite
# DATABASE_URL=sqlite:///./kg.db

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Vector Engine
VECTOR_DIM=768
VECTOR_MODEL=all-MiniLM-L6-v2

# Knowledge Base
KNOWLEDGE_SEED_PATH=../frontend/src/domain_corpus/software_kg.md

# 知识点判定：联网存在性确认
# confirmed 时分数不低于 FLOOR（至少进待审）；MIN_DOMAINS 为多源门槛
VERDICT_USE_WEB=true
VERDICT_WEB_EXISTENCE_FLOOR=0.35
VERDICT_WEB_MIN_DOMAINS=2
VERDICT_WEB_DESC_CONSISTENCY=0.25