+/**
+ * 把整张图缩放平移到画布中央（自动适配视图）。
+ *
+ * 为什么需要：节点间距调大后，力导布局的自然尺寸常常大于画布，
+ * 用户一进来只看到「半张图」，还得自己滚轮缩小才看得全 —— 第一眼就是残缺的。
+ * 只在数据变化后的首次收敛调用一次；用户手动缩放/拖拽之后不再覆盖他的视角。
+ */
+function fitToView(padding = 44) {
+  if (!svg || !gRoot) return
+  const nodes = graphStore.nodes || []
+  let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity
+  for (const n of nodes) {
+    if (!Number.isFinite(n.x) || !Number.isFinite(n.y)) continue
+    const r = nodeRadius(n) + 14       // 节点半径 + 标签余量
+    minX = Math.min(minX, n.x - r); maxX = Math.max(maxX, n.x + r)
+    minY = Math.min(minY, n.y - r); maxY = Math.max(maxY, n.y + r)
+  }
+  if (!Number.isFinite(minX)) return
+
+  const bw = Math.max(1, maxX - minX)
+  const bh = Math.max(1, maxY - minY)
+  const vw = width.value || 1
+  const vh = height.value || 1
+  // 上限 1.4：节点很少时不要把两三个点放大成巨物
+  const k = Math.max(0.2, Math.min((vw - padding * 2) / bw, (vh - padding * 2) / bh, 1.4))
+  const tx = vw / 2 - k * (minX + maxX) / 2
+  const ty = vh / 2 - k * (minY + maxY) / 2
+  svg.call(zoomBehavior.transform, zoomIdentity.translate(tx, ty).scale(k))
+}
