+const emit = defineEmits(['close', 'open-note'])
 
 const graphStore = useGraphStore()
 const groupStore = useGroupStore()
 
+/*
+ * 反向链接：打开抽屉时按节点 id 拉一次「哪些笔记写过它」。
+ * 分两段展示 —— 已关联 / 提到但没连。后者不是凑数：
+ * 它把「知识已经在笔记里、只是没连」的那部分捞出来，是补关联最快的地方。
+ */
+const noteRefs = ref({ loading: false, error: '', linked: [], mentioned: [] })
+
+watch(
+  () => [props.visible, props.node?.id],
+  async ([visible, id]) => {
+    if (!visible || !id) return
+    noteRefs.value = { loading: true, error: '', linked: [], mentioned: [] }
+    try {
+      const data = await knowledgeAPI.nodeNotes(id)
+      noteRefs.value = {
+        loading: false,
+        error: '',
+        linked: data.linked || [],
+        mentioned: data.mentioned || []
+      }
+    } catch (e) {
+      // 反向链接是辅助信息，失败不该让整个抽屉报错
+      noteRefs.value = { loading: false, error: '笔记引用加载失败，稍后可重试', linked: [], mentioned: [] }
+    }
+  },
+  { immediate: true }
+)
+
+function openNote(nr) {
+  emit('open-note', nr.id)
+}
