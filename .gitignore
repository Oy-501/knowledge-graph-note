# IDE
.idea/
.vscode/

# 环境变量（含 ADMIN_TOKEN 等口令，绝不入库）
.env
.env.local
.env.*.local

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Node
node_modules/
dist/
dist-old*/
.dist-old*/

# 备份文件
*.bak
*.bak-*

# 本地数据库
*.db
*.db.*
*.db-journal
*.sqlite
*.sqlite3

# 运行产物（不上传）
backend/uploads/
backend/exports/
backend/.env
# 向量模型权重（约 470MB，由 scripts/reembed.py 首次运行时自动下载到此处）
backend/models/

# 临时/工具目录
.tmp-verify/
.userdata/
.workbuddy/
.tmp-assets/

# 系统
.DS_Store
Thumbs.db

# 日志
*.log

# 临时工作目录（不随仓库上传）
.word_tmp/

# 本地工具脚本（含明文管理员密码，绝不入库）
backend/reset_admin.py

# Vite 崩溃残留的临时时间戳文件
kg-vue3/vite.config.js.timestamp-*.mjs

# SQLite WAL 运行期临时文件（kg.db-shm / kg.db-wal 非源码，每次运行都会变化）
*.db-shm
*.db-wal

