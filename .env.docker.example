# Docker 部署环境变量：复制为 .env 后修改
#   cp .env.docker.example .env

# 必填：管理员口令（浏览器登录之外，脚本/调试用的管理凭证）
ADMIN_TOKEN=change-me-to-a-long-random-secret

# 对外端口（默认 http://localhost:8080）
WEB_PORT=8080

# 可选 PostgreSQL（配合 docker compose --profile pg up -d）
# DB_MODE=postgres
# DATABASE_URL=postgresql://kg_user:kg_pass@db:5432/knowledge_graph
